{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "priority",
    "state",
    "paths"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "state": {
      "enum": [
        "ready",
        "claimed",
        "blocked",
        "blocked_external",
        "qa",
        "complete",
        "superseded"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
